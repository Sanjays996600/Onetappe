# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://onetappe:onetappe@localhost:5432/onetappe
# Used by integration tests; the database is wiped and re-migrated per run.
TEST_DATABASE_URL=postgres://onetappe:onetappe@localhost:5432/onetappe_test
# Derives the 4-digit start/complete codes. Use a long random value per environment.
VERIFICATION_CODE_SECRET=dev-only-secret-change-me-0123456789abcdef
