# Local development only. Copy to .env (never commit .env).
# Staging and production values live in the company's secret manager, never in files.
APP_ENV=local
PORT=3000
DATABASE_URL=postgres://onetappe:onetappe@localhost:5432/onetappe
# Integration tests; the database is wiped and re-migrated on every run.
TEST_DATABASE_URL=postgres://onetappe:onetappe@localhost:5432/onetappe_test

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TOKEN_SECRET=local-auth-token-secret-change-me-0123456789
OTP_HASH_SECRET=local-otp-hash-secret-change-me-01234567890
VERIFICATION_CODE_SECRET=local-verification-secret-change-me-012345
DATA_ENCRYPTION_KEY=bG9jYWwtb25seS1rZXktMzItYnl0ZXMtbG9uZyEhISE=

# OTP codes are printed to the API log locally. Staging/production use a real provider.
OTP_PROVIDER=console

# Simulated gateway for local work; staging uses Razorpay test keys (rzp_test_...).
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=local-sandbox-webhook-secret-change-me-01234

CORS_ORIGINS=http://localhost:3001

# Zoho CRM / Desk (off locally). Staging/production values come from the secret manager.
# Endpoints default to the India data centre (accounts.zoho.in, desk.zoho.in, zohoapis.in).
ZOHO_CRM_ENABLED=false
ZOHO_DESK_ENABLED=false
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_DESK_ORG_ID=
# ZOHO_DESK_WEBHOOK_SECRET=

# Database limits (defaults shown).
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Worker documents: local encrypted files for development; staging/production use a private
# S3 bucket (company AWS account, Block Public Access, KMS) and ClamAV scanning.
STORAGE_PROVIDER=local
MALWARE_SCANNER=none
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_KMS_KEY_ID=
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Notification providers (log = record only, local). Staging/production: fcm, msg91, zeptomail or none.
PUSH_PROVIDER=log
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
EMAIL_PROVIDER=log
