{
  "name": "@onetappe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "db:migrate": "tsx src/database/migrate.cli.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/database/db.generated.ts --exclude-pattern schema_migration --date-parser string --type-mapping '{\"int8\":\"number\"}'",
    "db:codegen:verify": "kysely-codegen --dialect postgres --out-file src/database/db.generated.ts --exclude-pattern schema_migration --date-parser string --type-mapping '{\"int8\":\"number\"}' --verify",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@onetappe/domain": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
